{
  "expo": {
    "name": "sigamovil",
    "slug": "sigamovil",
    "scheme": "sigamovil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconsiga.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SIGA Movil necesita la cámara para escanear los códigos QR de las etiquetas de los bienes muebles."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/iconsiga.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.sigamovil"
    },
    "web": {
      "favicon": "./assets/iconsiga.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba073501-7697-4c9e-8aaa-2f8a2f9c4df4"
      }
    },
    "owner": "jlmeza2k"
  }
}
